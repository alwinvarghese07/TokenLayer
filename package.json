{
  "name": "TokenLayer",
  "version": "1.0.0",
  "type": "module",
  "description": "Your Figma Plugin",
  "main": "dist/code.js",
  "scripts": {
    "build:ui": "vite build --config vite.config.ui.ts",
    "build:plugin": "vite build --config vite.config.plugin.ts",
    "build": "npm run build:ui && npm run build:plugin",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch:ui": "vite build --config vite.config.ui.ts --watch",
    "watch:plugin": "vite build --config vite.config.plugin.ts --watch"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
